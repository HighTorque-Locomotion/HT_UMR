{
  "extends": "umr_zoo3_piplus_s_40v_self_collision_strong.json",
  "robot": {
    "xml_policy": {"add_freejoint_root": false},
    "foot_bodies": {
      "left": "l_ankle_roll_link",
      "right": "r_ankle_roll_link"
    }
  },
  "solver": {
    "joint_smoothing_groups": {
      "shoulders": {
        "joints": ["*_shoulder_*_joint", "*_upper_arm_joint"],
        "smooth_cost": 4.0,
        "temporal_smooth_cost": 8.0
      },
      "legs": {
        "joints": ["*_hip_*_joint", "*_thigh_joint", "*_calf_joint", "*_ankle_*_joint"],
        "smooth_cost": 1.0,
        "temporal_smooth_cost": 1.0
      }
    }
  },
  "retarget": {
    "out": "../output/foot_clearance/zoo_3_foot_clearance.npz",
    "source_ground_align": "foot_surface",
    "foot_ground": {
      "low_height_percentile": 20.0,
      "stationary_speed": 0.15
    },
    "foot_clearance": {
      "enabled": true,
      "min_peak_height": 0.035,
      "swing_enter_height": 0.006,
      "swing_exit_height": 0.002,
      "min_detected_peak": 0.008,
      "min_swing_duration": 0.08,
      "swing_z_cost_multiplier": 3.0,
      "swing_height_cost": 5000.0,
      "stance_height_cost": 10000.0,
      "swing_height_hard_constraint": true,
      "swing_height_tolerance": 0.002,
      "swing_height_slack_cost": 100000.0
    }
  }
}
